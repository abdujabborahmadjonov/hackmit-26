# ---------------------------------------------------------------------------
# EduMatch backend configuration. Copy to .env and adjust. NEVER commit .env.
# ---------------------------------------------------------------------------

ENVIRONMENT=development
DEBUG=true

# --- database (async driver) ---
# A postgres:// URL from a managed provider is rewritten automatically, so you
# can paste Supabase/Neon/Render connection strings verbatim.
DATABASE_URL=postgresql+asyncpg://edumatch:edumatch@localhost:5432/edumatch
# Set to true when connecting through a TRANSACTION-mode pooler
# (Supabase port 6543, PgBouncer). Not needed for session-mode poolers.
DB_DISABLE_PREPARED_STATEMENTS=false

# --- auth ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-production-please-use-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# --- embeddings ---
# hashing = deterministic local fallback, no API key needed (default, great for demos)
# openai   = OpenAI embeddings      (EMBEDDING_MODEL=text-embedding-3-small)
# voyage   = Voyage AI embeddings   (EMBEDDING_MODEL=voyage-3-lite)
EMBEDDING_PROVIDER=hashing
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
# Vector width. Changing this requires a new migration for the vector columns.
EMBEDDING_DIM=384

# --- generative features (optional) ---
# An Anthropic API key enables the collaboration brief and syllabus import.
# Leave blank and those endpoints return 503; everything else is unaffected.
LLM_API_KEY=

# --- search engine ---
# postgres      = pgvector + SQL filters (no extra service, default)
# elasticsearch = Elasticsearch kNN + BM25 + geo_distance
SEARCH_PROVIDER=elasticsearch
ELASTICSEARCH_URL=https://my-vectordb-project-b04eea.es.us-central1.gcp.elastic.cloud:443
# Elastic Cloud: paste the encoded API key. Local docker ES can leave this blank.
ELASTICSEARCH_API_KEY=
# Username/password is the fallback for self-hosted clusters (ignored when the API key is set).
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
ELASTICSEARCH_TEACHER_INDEX=edumatch_teachers
ELASTICSEARCH_RESOURCE_INDEX=edumatch_resources

# --- file storage ---
# local    = disk under STORAGE_LOCAL_DIR (default)
# supabase = Supabase Storage over REST (no persistent disk required)
# s3       = any S3-compatible bucket (needs boto3)
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./storage
STORAGE_PUBLIC_BASE_URL=http://localhost:8000/static/uploads
MAX_UPLOAD_SIZE_MB=25
# S3 / MinIO (STORAGE_PROVIDER=s3)
S3_BUCKET=
S3_REGION=
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Supabase Storage (STORAGE_PROVIDER=supabase)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_STORAGE_BUCKET=resources

# --- http ---
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=120
AUTH_RATE_LIMIT_PER_MINUTE=20

# --- recommendation weights (must be tuned as a group; they are normalised anyway) ---
REC_WEIGHT_SEMANTIC=0.30
REC_WEIGHT_EXPERTISE=0.20
REC_WEIGHT_EDUCATION=0.15
REC_WEIGHT_TEACHING_LEVEL=0.15
REC_WEIGHT_LOCATION=0.10
REC_WEIGHT_CLASS_SIZE=0.10
# How many nearest neighbours to pull from pgvector before hybrid re-ranking
REC_CANDIDATE_POOL=300
